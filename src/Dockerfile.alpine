# Multi-stage Dockerfile for Alpine Linux
# Markus Peura  fmi.fi

FROM alpine:3.20 AS builder

RUN apk add --no-cache g++ make proj-dev hdf5-dev libpng-dev tiff-dev libgeotiff-dev

COPY . /rack
COPY install-rack-docker-alpine.cnf /rack/install-rack.cnf

WORKDIR /rack
RUN make build && make install

FROM alpine:3.20

RUN apk add --no-cache libgomp hdf5 proj libpng tiff libgeotiff

COPY --from=builder /usr/local/bin /usr/local/bin

CMD ["rack","--version"]
