# Conf for Docker image 'rack', using Alpine Linux

# Markus Peura  fmi.fi

# C++ standard
CXXSTD='-std=gnu++11'

# Include paths: Alpine installs headers directly to /usr/include, no subdirs needed
CCFLAGS='-I/usr/include'

# Library paths
LDFLAGS='-lhdf5 -lproj -lpng -ltiff -lgeotiff'

# Directory prefix for binary executable: ${prefix}/bin/
prefix='/usr/local'

# GeoTiff support (optional)
USE_GEOTIFF=YES
